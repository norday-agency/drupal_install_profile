{
  "name": "in10/drupal_install_profile",
  "description": "Default IN10 install profile for Drupal projects",
  "type": "drupal-profile",
  "license": "MIT",
  "authors": [
    {
      "name": "Stephan de Bruin",
      "email": "stephan.de.bruin@in10.nl"
    }
  ],
  "repositories": [
    {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    },
    {
      "type": "vcs",
      "url": "git@github.com:IN10/deployment"
    },
    {
      "type": "vcs",
      "url": "git@github.com:IN10/drupal_laravel_cache"
    }
  ],
  "require": {
    "drupal/adminimal_admin_toolbar": "^1.9",
    "drupal/adminimal_theme": "^1.4",
    "drupal/devel": "^2.1",
    "drupal/field_group": "^3.0@RC",
    "drupal/flysystem": "^1.0",
    "drupal/flysystem_s3": "^1.0@beta",
    "drupal/inline_entity_form": "^1.0@beta",
    "drupal/paragraphs": "^1.8",
    "drupal/pathauto": "^1.4",
    "drupal/registration_role": "^1.1@beta",
    "drupal/yoast_seo": "^1.5",
    "in10/deployment": "^4.0@alpha",
    "league/flysystem-aws-s3-v3": "^1.0",
    "drush/drush": "^10.0",
    "vlucas/phpdotenv": "^4.1"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "installer-paths": {
      "web/core": [
        "type:drupal-core"
      ],
      "web/libraries/{$name}": [
        "type:drupal-library"
      ],
      "web/modules/contrib/{$name}": [
        "type:drupal-module"
      ],
      "web/profiles/contrib/{$name}": [
        "type:drupal-profile"
      ],
      "web/themes/contrib/{$name}": [
        "type:drupal-theme"
      ],
      "drush/Commands/{$name}": [
        "type:drupal-drush"
      ]
    }
  }
}
